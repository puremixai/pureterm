{
  "name": "@pureterm/desktop",
  "version": "0.1.0-alpha.1",
  "private": true,
  "description": "PureTerm Electron desktop entry",
  "type": "module",
  "main": "dist/electron/app/main.js",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:boundaries": "node ../../scripts/check-boundaries.mjs",
    "clean": "node scripts/clean.mjs",
    "build:main": "node ../../scripts/build.mjs --desktop",
    "build:preload": "node scripts/build-preload.mjs",
    "build:renderer": "node ../../scripts/build-ui.mjs",
    "build": "node ../../scripts/build.mjs --desktop",
    "start": "npm run build && electron .",
    "test": "npm run verify",
    "test:unit": "node --test tests/*.test.mjs",
    "smoke:desktop": "npm run build:main && node tests/smoke-desktop.mjs",
    "smoke:host": "npm run build:main && node tests/smoke-host.mjs",
    "smoke:sftp": "npm run build:main && node tests/smoke-sftp.mjs",
    "smoke:carrier": "npm run build && node tests/smoke-carrier.mjs",
    "smoke:profile": "npm run build:main && node tests/smoke-launch-profile.mjs",
    "smoke:runner": "node tests/smoke-runner-decision.mjs",
    "smoke:electron": "npm run build && node tests/smoke-electron.mjs",
    "smoke:web": "npm run build && node tests/smoke-electron-web.mjs",
    "diagnose:electron": "node scripts/diagnose-electron.mjs",
    "boot": "npm run build && node scripts/boot-check.mjs",
    "launch": "npm run build && node scripts/launch.mjs",
    "smoke:node": "node tests/smoke-runner-decision.mjs && node tests/smoke-desktop.mjs && node tests/smoke-launch-profile.mjs && node tests/smoke-host.mjs && node tests/smoke-sftp.mjs && node tests/smoke-carrier.mjs",
    "smoke": "npm run build && npm run smoke:node && npm run verify:electron:built",
    "verify": "npm run verify --prefix ../..",
    "verify:electron": "npm run build && npm run verify:electron:built",
    "start:built": "electron .",
    "verify:electron:built": "node scripts/boot-check.mjs && node tests/smoke-electron.mjs && node tests/smoke-electron-web.mjs && node tests/smoke-renderer-crash.mjs && node tests/smoke-updates.mjs"
  },
  "dependencies": {
    "@pureterm/host": "*",
    "@pureterm/protocol": "*",
    "@pureterm/transport": "*",
    "@pureterm/ui": "*",
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "electron": "^44.3.0"
  }
}
