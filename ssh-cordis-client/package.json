{
  "name": "ssh-cordis-client",
  "version": "0.1.0",
  "private": true,
  "description": "Electron 壳 + Cordis 宿主 + xterm.js 的 SSH 客户端",
  "type": "module",
  "main": "dist/electron/main.js",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.renderer.json --noEmit && node scripts/check-esm-extensions.mjs",
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "node scripts/build-preload.mjs",
    "build:renderer": "node scripts/build-renderer.mjs",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "start": "npm run build && electron dist/electron/main.js",
    "smoke:desktop": "npm run build:main && node test/smoke-desktop.mjs",
    "smoke:host": "npm run build:main && node test/smoke-host.mjs",
    "smoke:sftp": "npm run build:main && node test/smoke-sftp.mjs",
    "smoke:carrier": "npm run build && node test/smoke-carrier.mjs",
    "smoke:profile": "npm run build && node test/smoke-launch-profile.mjs",
    "smoke:runner": "node test/smoke-runner-decision.mjs",
    "smoke:electron": "npm run build && node test/smoke-electron.mjs",
    "smoke:web": "npm run build && node test/smoke-electron-web.mjs",
    "diagnose:electron": "node scripts/diagnose-electron.mjs",
    "boot": "npm run build && node scripts/boot-check.mjs",
    "launch": "npm run build && node scripts/launch.mjs",
    "smoke": "npm run smoke:runner && npm run smoke:desktop && npm run smoke:host && npm run smoke:sftp && npm run smoke:carrier && npm run smoke:profile && npm run smoke:electron && npm run smoke:web",
    "verify": "npm run typecheck && npm run boot && npm run smoke"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "cordis": "^4.0.0-rc.10",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@types/ssh2": "^1.15.6",
    "electron": "^44.3.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  }
}
